use Infrangible\CatalogAttributeLandingPage\Block\Page;
use Magento\Framework\Escaper;

/** @var Page $block */
/** @var Escaper $escaper */

$imageUrl = $block->getImageUrlAt('description');
$description = $block->getDescription();
$logoUrl = $block->getLogoUrl();
?>
<?php if ($imageUrl !== null): ?>
    <div class="category-image">
        <img src="<?= $escaper->escapeUrl($imageUrl) ?>" alt="<?= $escaper->escapeHtmlAttr($block->getHeadline()) ?>"
             title="<?= $escaper->escapeHtmlAttr($block->getHeadline()) ?>" class="image"/>
    </div>
<?php endif; ?>
<?php if ($description !== ''): ?>
    <div class="category-description">
        <?php if ($logoUrl !== null): ?>
            <img src="<?= $escaper->escapeUrl($logoUrl) ?>" class="category-logo"
                 alt="<?= $escaper->escapeHtmlAttr($block->getHeadline()) ?>"
                 title="<?= $escaper->escapeHtmlAttr($block->getHeadline()) ?>"/>
        <?php endif; ?>
        <?= /* @noEscape */ $description ?>
    </div>
<?php endif; ?>
