use Infrangible\CatalogAttributeLandingPage\Block\Page;
use Magento\Framework\Escaper;

/** @var Page $block */
/** @var Escaper $escaper */

$imageUrl = $block->getImageUrlAt('cms');
$cmsBlockHtml = $block->getCmsBlockHtml();
$additionalCmsBlockHtml = $block->getAdditionalCmsBlockHtml();
?>
<?php if ($imageUrl !== null): ?>
    <div class="category-image">
        <img src="<?= $escaper->escapeUrl($imageUrl) ?>" alt="<?= $escaper->escapeHtmlAttr($block->getHeadline()) ?>"
             title="<?= $escaper->escapeHtmlAttr($block->getHeadline()) ?>" class="image"/>
    </div>
<?php endif; ?>
<?php if ($cmsBlockHtml !== '' || $additionalCmsBlockHtml !== ''): ?>
    <div class="category-cms">
        <?= /* @noEscape */ $cmsBlockHtml ?>
        <?= /* @noEscape */ $additionalCmsBlockHtml ?>
    </div>
<?php endif; ?>
