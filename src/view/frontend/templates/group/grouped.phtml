use Infrangible\CatalogAttributeLandingPage\Block\Group\Grouped;
use Magento\Framework\Escaper;

/** @var Grouped $block */
/** @var Escaper $escaper */

$groupedPages = $block->getGroupedPages();
$headlineLevel = min($block->getLevel() + 1, 6);
?>
<?php if ($block->isPages($groupedPages)): ?>
    <?= $block->getPagesHtml() ?>
<?php else: ?>
    <?php foreach ($groupedPages as $headline => $pages): ?>
        <h<?= /* @noEscape */ $headlineLevel ?>>
            <?= $escaper->escapeHtml((string)$headline) ?>
        </h<?= /* @noEscape */ $headlineLevel ?>>
        <?= $block->getGroupedPagesHtml(is_array($pages) ? $pages : []) ?>
    <?php endforeach; ?>
<?php endif; ?>
