use Infrangible\CatalogAttributeLandingPage\Block\Group\Grouped\Pages;
use Magento\Framework\Escaper;

/** @var Pages $block */
/** @var Escaper $escaper */
?>
<div class="landing-pages">
    <ol class="landing-pages-list">
        <?php foreach ($block->getPages() as $page): ?>
            <?php $headline = strip_tags($page->getHeadline()); ?>
            <?php $thumbnailUrl = $block->getThumbnailUrl($page); ?>
            <li class="landing-pages-item">
                <?php if ($thumbnailUrl !== null): ?>
                    <a href="<?= $escaper->escapeUrl($page->getUrl()) ?>" class="landing-pages-item-image">
                        <img src="<?= $escaper->escapeUrl($thumbnailUrl) ?>"
                             alt="<?= $escaper->escapeHtmlAttr($headline) ?>" width="210" loading="lazy"/>
                    </a>
                <?php endif; ?>
                <strong class="landing-pages-item-name">
                    <a href="<?= $escaper->escapeUrl($page->getUrl()) ?>"><?= $escaper->escapeHtml($headline) ?></a>
                </strong>
                <?= $block->getPageProductsHtml($page) ?>
                <div class="actions">
                    <a href="<?= $escaper->escapeUrl($page->getUrl()) ?>" class="action primary">
                        <span><?= $escaper->escapeHtml(__('View Products')) ?></span>
                    </a>
                </div>
            </li>
        <?php endforeach; ?>
    </ol>
</div>
